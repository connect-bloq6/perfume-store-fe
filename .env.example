# Copy to .env.local and fill in values:
#   cp .env.example .env.local

# --- Supabase (browser + middleware; safe to expose) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# --- Supabase service role (server only; never expose to the client) ---
# Dashboard → Project Settings → API → service_role secret
# Used for contact submissions, admin contact API, and newsletter inserts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Public app URL (metadata, absolute links) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional: API base (defaults to /api) ---
# NEXT_PUBLIC_API_URL=/api

# --- Admin login (separate from Supabase Auth; change in production) ---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
